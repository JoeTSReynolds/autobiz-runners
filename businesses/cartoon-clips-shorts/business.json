          "moduleId": "media-fetch",
          "position": {
            "x": 630,
            "y": 406
          },
          "config": {
            "mode": "search",
            "excludeWords": [
              "reaction",
              "review",
              "explained",
              "recap",
              "trailer",
              "teaser",
              "promo",
              "sneak peek",
              "first look",
